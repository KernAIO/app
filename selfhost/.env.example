# ===== Kern self-host configuration =====
# Public URL users open in the browser (Caddy terminates TLS automatically for real domains)
KERN_DOMAIN=kern.example.com
KERN_BASE_URL=https://kern.example.com
# Use "internal" for a self-signed cert on LAN/IP installs, or an email for Let's Encrypt
ACME_EMAIL=admin@example.com

# Release channel / versions (pinned by the kern repo release manifest)
# Image tag for every Kern service. `latest` follows the newest stable release; pin it to a version
# (e.g. 1.2.0) to control when you upgrade. This selects the image only — the version a running
# container reports is baked into the image itself, so the two can never drift.
KERN_VERSION=latest

# Time zone the optional updater container reads the update window in. The window and its zone are
# set in the interface (Admin -> Updates); this only affects the container's own clock.
TZ=UTC

# Secrets — install.sh generates these
KERN_SECRET=
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
S3_SECRET_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Postgres
POSTGRES_USER=kern
POSTGRES_DB=kern

# Object storage (bundled MinIO by default; point to any S3 for external)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://kern.example.com/s3
S3_REGION=us-east-1
S3_BUCKET=kern
S3_ACCESS_KEY=kern

# Instance default outbound email (workspaces can override with their own provider)
SMTP_URL=
MAIL_FROM="Kern <no-reply@kern.example.com>"

# Optional: first admin (created on first boot if set)
KERN_ADMIN_EMAIL=
KERN_ADMIN_PASSWORD=

# ===== Billing (optional) =====
# Kern ships a billing module in every image. It does nothing until you both define plans, in
# Admin -> Plans, and set a Stripe key here — so leaving this section empty is the normal
# self-hosted install: unlimited seats, unlimited storage, every module, no payment.
#
# Fill it in if you want to run your own Kern as a service and charge for workspaces on it.
# Use test keys (sk_test_...) until you are ready to take real money.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint you create in the Stripe dashboard pointing at
# https://your-domain/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Slug of the plan a newly created workspace starts on. Empty means no plan and no limits.
KERN_DEFAULT_PLAN_SLUG=
